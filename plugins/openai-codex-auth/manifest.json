{
    "id": "openai-codex-auth",
    "name": "OpenAI Codex Auth",
    "version": "1.9.0",
    "description": "Use ChatGPT Plus/Pro subscription with Alma via OAuth. Multi-account with email, avatar, and quota in settings; dynamic model discovery; Fast mode; GPT Image 2 generation and editing.",
    "author": {
        "name": "Alma Community"
    },
    "main": "main.js",
    "engines": {
        "alma": "^0.1.0"
    },
    "type": "provider",
    "permissions": [
        "network:fetch",
        "network:localhost",
        "network:domain:auth.openai.com",
        "network:domain:chatgpt.com",
        "providers:manage",
        "notifications"
    ],
    "activationEvents": [
        "onStartup"
    ],
    "contributes": {
        "providers": [
            {
                "id": "openai-codex",
                "name": "OpenAI Codex (ChatGPT)",
                "authType": "oauth"
            }
        ],
        "commands": [
            {
                "id": "openai-codex-auth.login",
                "title": "Login to ChatGPT (Codex)"
            },
            {
                "id": "openai-codex-auth.logout",
                "title": "Logout from ChatGPT (Codex)"
            }
        ],
        "configuration": {
            "title": "OpenAI Codex",
            "properties": {
                "openaiCodex.fastMode": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use the priority service tier (Codex CLI's /fast) on models that offer it. About 1.5x faster, and it draws down your ChatGPT plan's usage faster. Applies to the main agent and subagents."
                }
            }
        }
    },
    "keywords": [
        "openai",
        "codex",
        "chatgpt",
        "oauth",
        "gpt-5"
    ]
}
